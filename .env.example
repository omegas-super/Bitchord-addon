# All of this is optional — the preferred way to configure is the /setup page.
# These values seed the config on first boot (and re-seed on hosts with
# ephemeral disks, like Render free, whenever no saved config exists).

# --- identity / networking ---
# PORT=8080
# DATA_DIR=/data
# PUBLIC_URL=https://your-app.onrender.com
# SLUG=tidal-1
# LABEL=Tido Tidal Hi-Res

# --- initial password for /setup (min 6 chars; changeable in the UI) ---
# SETUP_PASSWORD=change-me

# --- backends (Tido first, then hifi-api instances, monochrome last) ---
# TIDO_URL=https://tido.tido.tido.rickyaddons.dpdns.org/<token>/manifest.json
# TIDO_REGEN_URL=https://tido.tido.tido.rickyaddons.dpdns.org/generate?k=<key>
#   Optional. When Tido starts 403ing, the addon POSTs this URL and adopts the
#   fresh manifest automatically (rate-limited: 1 regen / 10 min; plus a
#   "Regenerate manifest now" button on /setup). It cannot help while the
#   whole Tido upstream is down — every token 403s "Unavailable" identically
#   then (measured 2026-11) — but the failover ladder carries requests anyway.
# HIFI_API_URLS=https://my-hifi-api.example.com,https://backup.example.com
# Monochrome tracks backend (tracks.monochrome.st) — free lossless FLAC fallback
# MONO_ENABLED=true
# MONO_URL=https://tracks.monochrome.st

# --- quality ---
# AUDIO_QUALITY=MAX          # MAX | HIRES | LOSSLESS | HIGH | LOW
# EXACT_QUALITY=false
# HIDE_EXPLICIT=false
# VIDEOS_IN_SEARCH=true
# VIDEO_QUALITY=HIGH         # HIGH | MEDIUM | LOW

# --- keep-alive (Render free tier idles after 15 min; self-ping prevents it) ---
# KEEP_ALIVE=true            # auto-enabled when RENDER_EXTERNAL_URL is set
# SELF_PING_URL=https://your-app.onrender.com
# KEEP_ALIVE_INTERVAL=240    # seconds (min 60)

# --- logging / caches ---
# LOG_LEVEL=info             # debug | info | warn | error
# SEARCH_CACHE_TTL=60        # seconds
# STREAM_CACHE_TTL=600       # seconds
